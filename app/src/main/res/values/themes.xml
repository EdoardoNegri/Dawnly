<resources>
    <!-- Compose draws everything; the window theme only needs to stay dark while starting. -->
    <style name="Theme.SunWakeup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
    The night clock and the sunrise stand in for the lock screen and come and go with the screen, so they
    open with no animation, no starting window and no status bar showing first.
    -->
    <style name="Base.Theme.SunWakeup.LockScreen" parent="Theme.SunWakeup">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.SunWakeup.LockScreen" parent="Base.Theme.SunWakeup.LockScreen" />
</resources>
